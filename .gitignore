```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Dependencies
node_modules/

# Build/dist folders
build/
dist/
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
.coverage
coverage/
htmlcov/

# Temporary files
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Cache directories
.mypy_cache/
.pytest_cache/
.gradle/
```